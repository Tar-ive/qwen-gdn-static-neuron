# Filled in by you; read by infra/inf2_spot.sh. Any public subnet with outbound internet works.
REGION=us-east-1
SUBNETS="subnet-aaaa subnet-bbbb"
SG=sg-xxxx                      # outbound open; no inbound needed
INSTANCE_PROFILE=my-ec2-role    # s3:GetObject/PutObject/ListBucket on $BUCKET/$PREFIX/*
BUCKET=my-bucket
